# ============================================================
#  מועדון הלקוחות של קפה לפריקון — הגדרות
#  העתיקו לקובץ בשם .env ומלאו את הערכים.
# ============================================================

# ---------- בסיס ----------
NODE_ENV=production
PORT=3000

# הכתובת הפומבית של המערכת. חייבת להיות https בייצור —
# בלעדיה הכרטיסיות לא יתעדכנו אוטומטית בטלפונים.
BASE_URL=https://club.leprechaun.co.il

# מפתח חתימה. הריצו: node scripts/gen-secret.mjs
# ⚠️ שינוי המפתח מבטל את כל קודי ה-QR הקיימים.
APP_SECRET=

# ---------- פרטי העסק ----------
BUSINESS_NAME=קפה לפריקון
BUSINESS_NAME_EN=Leprechaun Cafe
BUSINESS_ADDRESS=דרך ארץ 58, חריש
BUSINESS_PHONE=+97246070067
BUSINESS_INSTAGRAM=https://instagram.com/cafeleprechaun

# קואורדינטות לצורך הצגת הכרטיסייה במסך הנעילה כשמגיעים לבית הקפה.
# העתיקו מ-Google Maps: לחיצה ימנית על המיקום → המספרים הראשונים.
BUSINESS_LAT=32.4647
BUSINESS_LNG=35.0447

# ---------- חוקי המועדון ----------
# 8 = קונים 8 קפה, התשיעי חינם
LOYALTY_GOAL=8
# מונע ניקוב כפול בטעות: שנייה סריקה בתוך X שניות תדרוש אישור
PUNCH_COOLDOWN_SECONDS=90
# כמה ניקובים אפשר להוסיף בסריקה אחת (למי שקונה 2 קפה יחד)
MAX_PUNCHES_PER_SCAN=3

# ---------- מנהל ראשוני ----------
# נוצר אוטומטית בהרצה הראשונה. אם משאירים ריק — תיווצר סיסמה אקראית
# שתודפס פעם אחת ב-console.
ADMIN_USERNAME=admin
ADMIN_NAME=מנהל
ADMIN_PASSWORD=

# ============================================================
#  Apple Wallet  (נדרש חשבון Apple Developer — 99$ לשנה)
#  ראו README → "הגדרת Apple Wallet"
# ============================================================
APPLE_WALLET_ENABLED=true

# מזהה סוג הכרטיסייה שיצרתם בפורטל אפל
APPLE_PASS_TYPE_ID=pass.co.il.leprechaun.loyalty
# ה-Team ID של החשבון (10 תווים, מופיע ב-Membership Details)
APPLE_TEAM_ID=

# --- אפשרות א׳: קובץ p12 (כמו שמייצאים מ-Keychain במק) ---
APPLE_P12_PATH=certs/pass.p12
APPLE_P12_PASSWORD=

# --- אפשרות ב׳: זוג קבצי PEM (נוח יותר בווינדוס עם OpenSSL) ---
# אם שתי השורות האלה מלאות, הן גוברות על ה-p12.
# APPLE_CERT_PEM_PATH=certs/pass.pem
# APPLE_KEY_PEM_PATH=certs/pass.key
# APPLE_KEY_PASSPHRASE=

# תעודת הביניים של אפל (Apple Worldwide Developer Relations)
APPLE_WWDR_PATH=certs/wwdr.pem

# חלופה לשרתים שלא מאפשרים העלאת קבצים — הדביקו base64 של אותם קבצים:
# APPLE_P12_BASE64=
# APPLE_CERT_PEM_BASE64=
# APPLE_KEY_PEM_BASE64=
# APPLE_WWDR_BASE64=

# ============================================================
#  Google Wallet  (חינם — נדרש חשבון Google Cloud)
#  ראו README → "הגדרת Google Wallet"
# ============================================================
GOOGLE_WALLET_ENABLED=true

# מתוך Google Pay & Wallet Console → Google Wallet API
GOOGLE_ISSUER_ID=
GOOGLE_CLASS_SUFFIX=leprechaun_coffee_card

# הדרך הפשוטה בפיתוח: נתיב לקובץ ה-JSON של חשבון השירות
GOOGLE_SA_FILE=certs/google-service-account.json

# הדרך בייצור (Railway וכו׳), כשאין קבצים — כל ה-JSON כ-base64 בשורה אחת.
# הריצו `npm run pack` כדי לייצר את השורה הזו מוכנה להדבקה.
# GOOGLE_SA_JSON_BASE64=

# חלופה: שתי השורות האלה במקום הקובץ
# GOOGLE_SA_EMAIL=wallet@your-project.iam.gserviceaccount.com
# GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ---------- מתקדם ----------
# DB_PATH=data/loyalty.db
# SESSION_HOURS=336
# APNS_HOST=https://api.push.apple.com
